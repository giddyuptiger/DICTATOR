<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.design.irons.dictator</string>
	</array>
	<!-- iCloud key-value store (personal-dictionary sync) is intentionally NOT
	     declared here. This app ships as a Developer ID / notarized DMG with
	     manual signing and no provisioning profile, and iCloud requires a profile
	     with the iCloud capability, which fails the archive. The shared code
	     (PersonalDictionary) degrades gracefully to the local App Group store
	     when the KVS is unavailable, so vocabulary still works on the Mac; it
	     just doesn't sync over iCloud. The iOS app keeps iCloud sync via its App
	     Store provisioning. -->
</dict>
</plist>
