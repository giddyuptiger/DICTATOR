<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- App Groups and iCloud key-value store are intentionally NOT declared on
	     the Mac target. Both require an embedded provisioning profile, which the
	     Developer ID / notarized-DMG pipeline (manual signing, no profile) cannot
	     supply, and each one fails the archive with "requires a provisioning
	     profile". The Mac app is a single non-sandboxed process with no extension
	     to share a group container with, so the shared code (SharedStore,
	     PersonalDictionary, ToneProfile) falls back to standard UserDefaults on
	     macOS, which persists identically. The only lost feature is iCloud
	     cross-device vocabulary sync; the iOS app keeps App Groups (keyboard↔app)
	     and iCloud sync via its App Store provisioning. -->
</dict>
</plist>
